# Copy this file to .env and fill in your values. Never commit .env.

# Which provider to use: openai | anthropic
LLM_PROVIDER=openai

# --- OpenAI (or any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.4-mini
# Optional: point to an OpenAI-compatible provider (e.g. a free tier).
# Groq:       https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
# OPENAI_BASE_URL=

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Generation settings (all optional) ---
# Leave LLM_TEMPERATURE unset for current models: recent Claude models and
# OpenAI reasoning models reject sampling parameters. Range 0-2 (0-1 for Anthropic).
# LLM_TEMPERATURE=0.7
# Reasoning models count reasoning tokens here too, so keep some headroom.
LLM_MAX_TOKENS=1024
LLM_MAX_RETRIES=2
